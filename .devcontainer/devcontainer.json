{
  "name": "IoT Firmware Security Scanner",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "njpwerner.autodocstring",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "iot_scanner/tests"
        ]
      }
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y binwalk yara libmagic1 squashfs-tools && pip install -r requirements.txt",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "IoT Scanner Web Dashboard",
      "onAutoForward": "openBrowser"
    }
  }
}
